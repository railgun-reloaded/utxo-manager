{
  "name": "@railgun-reloaded/utxo-manager",
  "version": "0.0.1",
  "description": "UTXO manager and solver for selecting spending-solutions.",
  "homepage": "https://github.com/railgun-reloaded/utxo-manager#readme",
  "bugs": {
    "url": "https://github.com/railgun-reloaded/utxo-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/railgun-reloaded/utxo-manager.git"
  },
  "license": "MIT",
  "author": "RAILGUN Project Contributors",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc --build",
    "prepare": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "npm run build && node --test ./test/**/*.test.js",
    "test-only": "npm run build && node --test-only ./test/*.test.js",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=html node --test ./test/**/*.test.js"
  },
  "devDependencies": {
    "@railgun-reloaded/eslint-config": "^1.1.0",
    "@railgun-reloaded/tsconfig": "^1.0.1",
    "@types/node": "^22.13.10",
    "c8": "^10.1.3",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@railgun-reloaded/bytes": "git+https://github.com/railgun-reloaded/bytes.git#dev"
  }
}
